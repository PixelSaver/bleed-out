; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Bleed Out"
run/main_scene="uid://ch81su7nh77vx"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/show_image=false
config/icon="res://assets/icon.svg"

[autoload]

Global="*uid://cw2cid6mippjr"
SignalBus="*uid://76heinnvc1fe"
SceneDatabase="*uid://b7w6r5xa8o86w"
PhantomCameraManager="*uid://duq6jhf6unyis"

[display]

window/hdr/request_hdr_output=true
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/StyleboxFancy/plugin.cfg", "res://addons/cheatsheet_viewer/plugin.cfg", "res://addons/godot_super-wakatime/plugin.cfg", "res://addons/phantom_camera/plugin.cfg")

[file_customization]

