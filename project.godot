config_version=5

[application]

config/name="Bleed Out"
run/main_scene="uid://ch81su7nh77vx"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/image="uid://crf18mjg1sewy"
config/icon="uid://d2bbl3m6ys42h"

[audio]

buses/default_bus_layout="uid://byyql06xnstoo"

[autoload]

Global="*uid://cw2cid6mippjr"
SignalBus="*uid://76heinnvc1fe"
SceneDatabase="*uid://b7w6r5xa8o86w"
PhantomCameraManager="*uid://duq6jhf6unyis"
AudioManager="*uid://cshuwgx7lgt4j"

[display]

window/hdr/request_hdr_output=true
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/Spatial Navigation Mapper/plugin.cfg", "res://addons/Spatial navigation mapper/plugin.cfg", "res://addons/StyleboxFancy/plugin.cfg", "res://addons/cheatsheet_viewer/plugin.cfg", "res://addons/godot-spatial-navigation-mapper-main/Spatial navigation mapper/plugin.cfg", "res://addons/godot_super-wakatime/plugin.cfg", "res://addons/phantom_camera/plugin.cfg")

